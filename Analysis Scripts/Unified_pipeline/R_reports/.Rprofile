# Install R packages from a dated Posit Package Manager snapshot of CRAN: it
# serves prebuilt macOS/Windows binaries of exactly the versions in renv.lock.
# Keep this date in step with renv.lock (see README "For maintainers").
options(repos = c(CRAN = "https://packagemanager.posit.co/cran/2026-11-17"))
source("renv/activate.R")
